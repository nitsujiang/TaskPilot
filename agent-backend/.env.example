# =============================================================================
# Copy this file to .env in this folder and fill in real values.
# This single .env is used by BOTH the backend server and the notebook. Never commit .env.
# =============================================================================

# --- Backend server (agent-backend): required for uvicorn / FastAPI ---

# Where profile data and Google OAuth tokens are stored (e.g. Neon Postgres).
# The server creates a "profiles" table here. Get a connection string from neon.tech.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Google OAuth app credentials. Create an OAuth 2.0 Client ID (Web application) in
# Google Cloud Console and set the redirect URI to: {APP_EXTERNAL_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# The URL the outside world uses to reach this server (e.g. Google redirects users here after sign-in).
# Use http://localhost:8000 when running locally; use your public URL in production.
APP_EXTERNAL_URL=http://localhost:8000

# A secret string the server expects in the X-Backend-Key header. Protects API routes so only
# your notebook or trusted clients can call /profiles/check, /calendar/list, /drive/search.
BACKEND_API_KEY=your-random-backend-key

# A secret string used to sign OAuth "state" so the server can verify the callback came from
# the same browser session. Generate a long random value (e.g. openssl rand -hex 32).
STATE_SIGNING_SECRET=your-random-state-secret

# --- Notebook (Option B profiling + LLM): required when running the notebook ---

# The URL the notebook uses to call the backend API (profiles/check, drive/search, calendar/list).
# When running everything locally, this is the same as APP_EXTERNAL_URL.
API_ENDPOINT=http://localhost:8000

# Gemini API key for the notebook's LLM (ChatGoogleGenerativeAI). Get one at aistudio.google.com.
# The notebook sends this to Google when generating answers; the backend does not use it.
# Use no quotes, or the key may be read incorrectly: GOOGLE_API_KEY_AI=AIzaSy...
GOOGLE_API_KEY_AI=your-gemini-api-key

# Optional: Gmail to use as the profile for Calendar/Drive. Whoever runs the notebook can set this
# to their own Gmail here (one per .env); if unset, the notebook cell uses the variable in the code.
# PROFILE_EMAIL=your.email@gmail.com
